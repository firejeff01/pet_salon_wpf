<UserControl x:Class="PetSalon.Wpf.Dialogs.ContractGenerateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ContractGenerateDialogViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Caption, StringFormat='產生契約 PDF — {0}'}"
                   FontWeight="Bold" FontSize="18" Margin="0,0,0,8"
                   Foreground="{StaticResource Brown700Brush}" />

        <TextBlock Grid.Row="1" Margin="0,0,0,8" FontSize="12"
                   Foreground="{StaticResource Brown500Brush}"
                   Text="以下為契約預覽。請確認內容無誤後再按「產生 PDF」存檔，按下後將寫入正式契約目錄並開啟。" />

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 美容人員簽名 → 契約第一頁「美容人員簽名」欄位 -->
            <TextBlock Text="美容人員簽名：" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding GroomerSignatures}"
                      SelectedItem="{Binding SelectedGroomerSignature}"
                      DisplayMemberPath="Name" MinHeight="32"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                      AutomationProperties.AutomationId="cmb-contract-groomer-signature" />
            <Button Grid.Column="2" Content="本次不套用" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ClearGroomerSignatureCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    AutomationProperties.AutomationId="btn-contract-clear-groomer-signature" />

            <!-- 負責人簽名 → 契約最後一頁「乙方簽章」欄位 -->
            <TextBlock Grid.Row="1" Text="負責人簽名：" VerticalAlignment="Center" Margin="0,6,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ManagerSignatures}"
                      SelectedItem="{Binding SelectedManagerSignature}"
                      DisplayMemberPath="Name" MinHeight="32" Margin="0,6,0,0"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                      AutomationProperties.AutomationId="cmb-contract-manager-signature" />
            <Button Grid.Row="1" Grid.Column="2" Content="本次不套用" Margin="8,6,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ClearManagerSignatureCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    AutomationProperties.AutomationId="btn-contract-clear-manager-signature" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0"
                       FontSize="11" Foreground="{StaticResource Brown500Brush}" TextWrapping="Wrap"
                       Text="各角色的預設簽名會自動選取；也可只針對本份契約切換。美容人員簽名帶入第一頁「美容人員簽名」欄，負責人簽名帶入末頁「乙方簽章」欄。" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="White">
            <Grid>
                <!-- 載入中提示，PreviewUri 為 null 時顯示 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding PreviewUri, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="📄 預覽產生中⋯⋯" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brown500Brush}" />
                    <TextBlock Text="第一次開啟若 Chromium 尚未下載，可能需要 30–60 秒"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{StaticResource Brown500Brush}" />
                </StackPanel>

                <wv2:WebView2 x:Name="PreviewView" Source="{Binding PreviewUri}"
                              Visibility="{Binding PreviewUri, Converter={StaticResource NotNullToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="btn-contract-cancel" />
                <Button Content="產生 PDF" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GenerateCommand}" IsDefault="True"
                        IsEnabled="{Binding CanGenerate}"
                        AutomationProperties.AutomationId="btn-generate-contract" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
