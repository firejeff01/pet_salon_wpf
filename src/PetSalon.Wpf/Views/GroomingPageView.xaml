<UserControl x:Class="PetSalon.Wpf.Views.GroomingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GroomingPageViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題列 + 動作按鈕 -->
        <Border Style="{StaticResource CardStyle}" Padding="20,14" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="← 返回當日"
                            Command="{Binding BackCommand}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="💾 儲存紀錄"
                            Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                    <Button Style="{StaticResource SuccessButtonStyle}" Content="📄 產生契約 PDF"
                            Command="{Binding GenerateContractCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="20" Foreground="{StaticResource Brown700Brush}">
                        <Run Text="美容紀錄 — " /><Run Text="{Binding OwnerName, Mode=OneWay}" />
                        <Run Text=" / " /><Run Text="{Binding PetName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource Brown500Brush}" Margin="0,4,0,0">
                        <Run Text="{Binding ServiceDate, StringFormat='{}{0:yyyy/MM/dd}'}" />
                        <Run Text=" " />
                        <Run Text="{Binding ServiceTime, StringFormat='HH:mm'}" />
                        <Run Text="  ·  電話 " />
                        <Run Text="{Binding OwnerPhone, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding PetSpecies, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding PetBreed, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

                <!-- 左欄：服務 + 體檢 + 個性病史 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <!-- 服務多選 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="本次服務" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="金額（NTD）"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsSelected}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0" Padding="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="合計金額" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource Brown700Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="22"
                                               Foreground="{StaticResource Pink600Brush}">
                                        <Run Text="NTD " />
                                        <Run Text="{Binding TotalCost, StringFormat=N0, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 身體檢查 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="身體檢查" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <UniformGrid Rows="2" Columns="3">
                                <UniformGrid.Resources>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                    </Style>
                                </UniformGrid.Resources>
                                <StackPanel>
                                    <TextBlock Text="眼睛" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox AutomationProperties.AutomationId="cmb-phys-eyes"
                                              ItemsSource="{Binding BodyConditions}" SelectedItem="{Binding EyesCondition}" />
                                    <TextBox AutomationProperties.AutomationId="txt-phys-eyes-note"
                                             Text="{Binding EyesNote, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" Margin="0,4,0,0"
                                             Visibility="{Binding EyesNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="耳朵" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox AutomationProperties.AutomationId="cmb-phys-ears"
                                              ItemsSource="{Binding BodyConditions}" SelectedItem="{Binding EarsCondition}" />
                                    <TextBox AutomationProperties.AutomationId="txt-phys-ears-note"
                                             Text="{Binding EarsNote, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" Margin="0,4,0,0"
                                             Visibility="{Binding EarsNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="牙齒" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox AutomationProperties.AutomationId="cmb-phys-teeth"
                                              ItemsSource="{Binding BodyConditions}" SelectedItem="{Binding TeethCondition}" />
                                    <TextBox AutomationProperties.AutomationId="txt-phys-teeth-note"
                                             Text="{Binding TeethNote, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" Margin="0,4,0,0"
                                             Visibility="{Binding TeethNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="四肢" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox AutomationProperties.AutomationId="cmb-phys-limbs"
                                              ItemsSource="{Binding BodyConditions}" SelectedItem="{Binding LimbsCondition}" />
                                    <TextBox AutomationProperties.AutomationId="txt-phys-limbs-note"
                                             Text="{Binding LimbsNote, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" Margin="0,4,0,0"
                                             Visibility="{Binding LimbsNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="皮膚" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox AutomationProperties.AutomationId="cmb-phys-skin"
                                              ItemsSource="{Binding BodyConditions}" SelectedItem="{Binding SkinCondition}" />
                                    <TextBox AutomationProperties.AutomationId="txt-phys-skin-note"
                                             Text="{Binding SkinNote, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" Margin="0,4,0,0"
                                             Visibility="{Binding SkinNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="皮毛" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox AutomationProperties.AutomationId="cmb-phys-fur"
                                              ItemsSource="{Binding FurConditions}" SelectedItem="{Binding FurCondition}" />
                                    <!-- Q8: 皮毛 Note 只在含「異常」時顯示 -->
                                    <TextBox AutomationProperties.AutomationId="txt-phys-fur-note"
                                             Text="{Binding FurNote, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" Margin="0,4,0,0"
                                             Visibility="{Binding FurNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 個性 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="個性" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Personality}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Margin="0,4,18,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 病史 -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="病史（勾「以上皆無」將清除其他選項）" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding MedicalHistory}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Margin="0,4,18,4"
                                                  AutomationProperties.AutomationId="{Binding Name, StringFormat='cb-medical-{0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="其他病史說明" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding MedicalHistoryOther, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                        </StackPanel>
                    </Border>

                    <!-- 備註 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="備註" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <TextBlock Text="飼主備註" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding OwnerNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                            <TextBlock Text="店家備註" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding ShopNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                            <TextBlock Text="其他備註" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding OtherNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右欄：儲值區 + 契約版本 -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                            Visibility="{Binding IsStoredValueCustomer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="💳 儲值客戶" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="目前餘額" Foreground="{StaticResource Brown500Brush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold">
                                    <Run Text="{Binding StoredValueBalance, StringFormat=N0}" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="本次扣抵" Foreground="{StaticResource Brown500Brush}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource Pink600Brush}">
                                    <Run Text="-" /><Run Text="{Binding StoredValueDeduction, StringFormat=N0}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="現金應付" Foreground="{StaticResource Brown500Brush}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0">
                                    <Run Text="{Binding CashPayment, StringFormat=N0}" />
                                </TextBlock>
                                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="餘額" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource Pink700Brush}">
                                            <Run Text="{Binding StoredValueRemaining, StringFormat=N0}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 契約版本 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="📄 契約版本" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                            <TextBlock Text="尚未產生契約 PDF" Foreground="{StaticResource Brown500Brush}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContractVersions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ContractVersions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,3" Padding="10,6" HorizontalContentAlignment="Stretch"
                                                Background="{StaticResource Pink50Brush}" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource Brown700Brush}"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenContractCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                                    <Run Text="v" /><Run Text="{Binding Version}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Brown500Brush}"
                                                           Text="{Binding GeneratedAt, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
        </Grid>
    </Grid>
</UserControl>
