<UserControl x:Class="PetSalon.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HomeViewModel}">
    <StackPanel>
        <!-- Hero 卡（粉漸層 + 標題 + 兩個 CTA + 浮動 emoji） -->
        <Border CornerRadius="24" Background="{StaticResource HeroGradientBrush}"
                Padding="48,40" Effect="{StaticResource ShadowLg}" Margin="0,0,0,28">
            <Grid>
                <!-- 裝飾 emoji（右側） -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                            Opacity="0.55">
                    <TextBlock Text="🐶" FontSize="56" />
                    <TextBlock Text="🐱" FontSize="48" Margin="36,-12,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" MaxWidth="700">
                    <TextBlock Foreground="{StaticResource Pink700Brush}" FontSize="14" FontWeight="SemiBold">
                        <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text="，今天是 " />
                        <Run Text="{Binding TodayDateLabel}" />
                    </TextBlock>
                    <TextBlock Text="歡迎回來 🐾" FontFamily="Microsoft JhengHei UI" FontWeight="Bold"
                               FontSize="40" Foreground="{StaticResource Brown700Brush}" Margin="0,8,0,4" />
                    <TextBlock Text="今天也要把毛孩子打理得漂漂亮亮喔！"
                               FontSize="16" Foreground="{StaticResource Brown500Brush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="查看今日預約"
                                AutomationProperties.AutomationId="btn-home-go-today"
                                Command="{Binding GoTodayCommand}" Padding="24,12" FontSize="15" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="新增飼主"
                                AutomationProperties.AutomationId="btn-home-go-owners"
                                Command="{Binding GoOwnersCommand}" Padding="24,12" FontSize="15" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 功能卡網格 -->
        <UniformGrid Rows="1" Columns="4">
            <UniformGrid.Resources>
                <Style x:Key="FuncCardStyle" TargetType="Border">
                    <Setter Property="CornerRadius" Value="20" />
                    <Setter Property="Padding" Value="22" />
                    <Setter Property="Margin" Value="0,0,16,0" />
                    <Setter Property="Effect" Value="{StaticResource ShadowMd}" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style x:Key="FuncCardTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Microsoft JhengHei UI" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="Foreground" Value="{StaticResource Brown700Brush}" />
                    <Setter Property="Margin" Value="0,12,0,4" />
                </Style>
                <Style x:Key="FuncCardDescStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{StaticResource Brown500Brush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="FuncCardIconStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="44" />
                </Style>
            </UniformGrid.Resources>

            <Border Style="{StaticResource FuncCardStyle}" Background="{StaticResource CardPinkGradient}"
                    MouseLeftButtonUp="OnGoOwners">
                <StackPanel>
                    <TextBlock Text="👤" Style="{StaticResource FuncCardIconStyle}" />
                    <TextBlock Text="飼主管理" Style="{StaticResource FuncCardTitleStyle}" />
                    <TextBlock Text="管理飼主與寵物的詳細資料，建立新預約。" Style="{StaticResource FuncCardDescStyle}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource Pink700Brush}" FontWeight="SemiBold" Margin="0,10,0,0">
                        <Run Text="目前共有 " />
                        <Run Text="{Binding OwnerCount, Mode=OneWay}" />
                        <Run Text=" 位飼主 · " />
                        <Run Text="{Binding PetCount, Mode=OneWay}" />
                        <Run Text=" 隻寵物" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FuncCardStyle}" Background="{StaticResource CardPeachGradient}"
                    MouseLeftButtonUp="OnGoCalendar">
                <StackPanel>
                    <TextBlock Text="📅" Style="{StaticResource FuncCardIconStyle}" />
                    <TextBlock Text="預約日曆" Style="{StaticResource FuncCardTitleStyle}" />
                    <TextBlock Text="檢視月/週/日視圖，掌握每天的預約安排。" Style="{StaticResource FuncCardDescStyle}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource Pink700Brush}" FontWeight="SemiBold" Margin="0,10,0,0">
                        <Run Text="今天有 " />
                        <Run Text="{Binding TodayCount, Mode=OneWay}" />
                        <Run Text=" 筆預約" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FuncCardStyle}" Background="{StaticResource CardMintGradient}"
                    MouseLeftButtonUp="OnGoCustomer">
                <StackPanel>
                    <TextBlock Text="📝" Style="{StaticResource FuncCardIconStyle}" />
                    <TextBlock Text="客戶填寫" Style="{StaticResource FuncCardTitleStyle}" />
                    <TextBlock Text="把畫面交給飼主自己填寫資料，方便又快速。" Style="{StaticResource FuncCardDescStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FuncCardStyle}" Background="{StaticResource CardLavenderGradient}"
                    Margin="0" MouseLeftButtonUp="OnGoBackup">
                <StackPanel>
                    <TextBlock Text="💾" Style="{StaticResource FuncCardIconStyle}" />
                    <TextBlock Text="備份管理" Style="{StaticResource FuncCardTitleStyle}" />
                    <TextBlock Text="一鍵備份所有資料，安心無憂。" Style="{StaticResource FuncCardDescStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
