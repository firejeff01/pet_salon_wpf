<UserControl x:Class="PetSalon.Wpf.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:cv="clr-namespace:PetSalon.Wpf.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CalendarViewModel}">
    <UserControl.Resources>
        <cv:BoolToBrushConverter x:Key="MonthDayInkConverter"
                                 TrueBrush="{StaticResource Brown700Brush}"
                                 FalseBrush="{StaticResource Brown300Brush}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-view-month" Content="月" Command="{Binding SwitchToMonthCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-view-week" Content="週" Command="{Binding SwitchToWeekCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-view-day" Content="日" Command="{Binding SwitchToDayCommand}" Margin="0,0,12,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-view-today" Content="今天" Command="{Binding TodayCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-cal-prev" Content="◀" Command="{Binding PrevMonthCommand}" Width="40" Padding="0,8" />
                    <TextBlock AutomationProperties.AutomationId="txt-cal-month-label"
                               Text="{Binding MonthLabel}" FontFamily="Microsoft JhengHei UI" FontSize="20"
                               FontWeight="Bold" Foreground="{StaticResource Brown700Brush}"
                               VerticalAlignment="Center" Margin="16,0" MinWidth="180" TextAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-cal-next" Content="▶" Command="{Binding NextMonthCommand}" Width="40" Padding="0,8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Columns="7" Margin="2,0,2,6">
            <UniformGrid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0,8" />
                    <Setter Property="Foreground" Value="{StaticResource Brown500Brush}" />
                </Style>
            </UniformGrid.Resources>
            <TextBlock Text="週日" Foreground="{StaticResource Pink600Brush}" />
            <TextBlock Text="週一" />
            <TextBlock Text="週二" />
            <TextBlock Text="週三" />
            <TextBlock Text="週四" />
            <TextBlock Text="週五" />
            <TextBlock Text="週六" Foreground="{StaticResource InfoBrush}" />
        </UniformGrid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="16" Effect="{StaticResource ShadowMd}" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Cursor="Hand" Padding="0"
                                Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.5">
                                        <Grid Margin="10,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DayLabel}" FontWeight="Bold" FontSize="14"
                                                       Foreground="{Binding IsCurrentMonth, Converter={StaticResource MonthDayInkConverter}}" />
                                            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    Background="{StaticResource Pink500Brush}" CornerRadius="999" Padding="8,2"
                                                    Visibility="{Binding HasAppointments, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock FontWeight="Bold" FontSize="11" Foreground="White">
                                                    <Run Text="預約 " /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" 筆" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Pink50Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource BgBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Pink100Brush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
