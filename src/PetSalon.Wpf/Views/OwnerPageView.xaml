<UserControl x:Class="PetSalon.Wpf.Views.OwnerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:helper="clr-namespace:PetSalon.Wpf.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OwnerPageViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: 搜尋 + 飼主列表 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16">
                    <TextBlock Text="飼主列表" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="txt-search"
                             Tag="搜尋姓名 / 電話 / 身分證" Margin="0,0,0,8">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="＋ 新增飼主"
                            AutomationProperties.AutomationId="btn-new-owner"
                            Command="{Binding NewOwnerCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}"
                         AutomationProperties.AutomationId="list-owners"
                         BorderThickness="0" Background="Transparent" Margin="8,0,8,16">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pink50Brush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pink100Brush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource Brown700Brush}" />
                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource Brown500Brush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main: 飼主表單 + 寵物清單（依靠 MainWindow 外層 ScrollViewer 捲動） -->
        <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        AutomationProperties.AutomationId="btn-delete-owner"
                                        Content="🗑 刪除飼主" Command="{Binding DeleteOwnerCommand}"
                                        IsEnabled="{Binding SelectedOwner, Converter={StaticResource NotNullToBoolConverter}}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="btn-save-owner"
                                        Content="💾 儲存" Command="{Binding SaveCommand}" />
                            </StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="18" Foreground="{StaticResource Brown700Brush}"
                                       Text="飼主資料" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock helper:LabelHelper.RequiredText="姓名" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-name" Text="{Binding Form.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock helper:LabelHelper.RequiredText="身分證字號" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-national-id" Text="{Binding Form.NationalId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock helper:LabelHelper.RequiredText="聯絡電話" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-phone" Text="{Binding Form.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock helper:LabelHelper.RequiredText="通訊地址" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-address" Text="{Binding Form.Address, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="緊急聯絡人" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-emergency-name" Text="{Binding Form.EmergencyContactName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="緊急聯絡人電話" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-emergency-phone" Text="{Binding Form.EmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="關係" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-emergency-relationship" Text="{Binding Form.EmergencyContactRelationship, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <CheckBox Content="儲值客戶" IsChecked="{Binding Form.IsStoredValueCustomer}" VerticalAlignment="Center" />
                                <TextBlock Text="餘額：" Style="{StaticResource FieldLabelStyle}" Margin="16,0,4,0" VerticalAlignment="Center" />
                                <TextBox Width="100" Text="{Binding Form.StoredValueBalance, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                <TextBlock Text="飼主備註" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox AutomationProperties.AutomationId="txt-owner-note"
                                         Text="{Binding Form.Note, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- 寵物 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="btn-add-appointment"
                                        Content="📅 新增預約"
                                        Command="{Binding AddAppointmentCommand}"
                                        IsEnabled="{Binding SelectedOwner, Converter={StaticResource NotNullToBoolConverter}}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="btn-add-pet"
                                        Content="＋ 新增寵物"
                                        Command="{Binding AddPetCommand}"
                                        IsEnabled="{Binding SelectedOwner, Converter={StaticResource NotNullToBoolConverter}}" />
                            </StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="16" Foreground="{StaticResource Brown700Brush}"
                                       Text="飼主的寵物" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- 未選飼主提示 -->
                        <TextBlock Foreground="{StaticResource Brown500Brush}" FontSize="13" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Text" Value="請先在左側選取或新增飼主後，才能加寵物" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOwner}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding OwnerPets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Margin="0,0,12,12" Padding="14"
                                            Background="{StaticResource Pink50Brush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="14" Cursor="Hand"
                                            MouseLeftButtonUp="OnPetCardClicked">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                       Foreground="{StaticResource Brown700Brush}" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource Brown500Brush}">
                                                <Run Text="{Binding Species}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Breed}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
        </StackPanel>
    </Grid>
</UserControl>
