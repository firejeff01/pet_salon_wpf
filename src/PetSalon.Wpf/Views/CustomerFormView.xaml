<UserControl x:Class="PetSalon.Wpf.Views.CustomerFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:helper="clr-namespace:PetSalon.Wpf.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CustomerFormViewModel}">
    <StackPanel HorizontalAlignment="Stretch">
            <!-- 歡迎卡 -->
            <Border Background="{StaticResource HeroGradientBrush}" CornerRadius="20" Padding="32" Margin="0,0,0,18"
                    Effect="{StaticResource ShadowMd}">
                <StackPanel>
                    <TextBlock Text="📝 客戶資料填寫" FontWeight="Bold" FontSize="26"
                               Foreground="{StaticResource Brown700Brush}" />
                    <TextBlock Text="歡迎！請填寫您與毛孩的基本資料，店員之後會協助安排預約。"
                               Foreground="{StaticResource Brown500Brush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 飼主 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="👤 您的資料" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource Brown700Brush}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock helper:LabelHelper.RequiredText="姓名" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,10">
                            <TextBlock helper:LabelHelper.RequiredText="身分證字號" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.NationalId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,10">
                            <TextBlock helper:LabelHelper.RequiredText="聯絡電話" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.Phone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock helper:LabelHelper.RequiredText="通訊地址" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.Address, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="緊急聯絡人" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.EmergencyContactName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="緊急聯絡人電話" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.EmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="關係" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Owner.EmergencyContactRelationship, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Text="飼主備註" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox AutomationProperties.AutomationId="txt-customer-owner-note"
                                     Text="{Binding Owner.Note, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 寵物（可動態增減） -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="btn-customer-add-pet"
                                Content="＋ 多新增一隻" Command="{Binding AddPetEntryCommand}" Padding="14,6" FontSize="12" />
                        <TextBlock Text="🐾 毛孩資料（選填，可填多隻）" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource Brown700Brush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Pets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6,0,6" Padding="12" Background="{StaticResource Pink50Brush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}"
                                                    Content="× 移除"
                                                    Command="{Binding DataContext.RemovePetEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,4" FontSize="11" />
                                            <TextBlock Text="🐾 寵物" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                                <TextBlock Text="名稱" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,8">
                                                <TextBlock Text="物種" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding DataContext.SpeciesList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding Species}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,8">
                                                <TextBlock Text="品種" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Breed, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="性別" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox ItemsSource="{Binding DataContext.GenderList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding Gender}" Width="100" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                    <TextBlock Text="年齡" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="已結紮" IsChecked="{Binding IsNeutered}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                            </Grid>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                <TextBlock Text="個性（用逗號分隔）" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding PersonalityRaw, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="是否有晶片" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox AutomationProperties.AutomationId="cmb-customer-chip-status"
                                                              ItemsSource="{Binding DataContext.ChipStatusList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding ChipStatus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Visibility="{Binding ShowChipData, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="晶片號碼／替代識別方式" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox AutomationProperties.AutomationId="txt-customer-chip-data"
                                                             Text="{Binding ChipData, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                                    <TextBlock Text="選擇「有」時晶片號碼必填；選擇「無」可填項圈牌等識別方式。"
                                                               FontSize="11" Foreground="{StaticResource Brown500Brush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                                <TextBlock Text="病史" Style="{StaticResource FieldLabelStyle}" />
                                                <ItemsControl ItemsSource="{Binding MedicalHistory}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                                      Margin="0,3,14,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                                        Visibility="{Binding ShowMedicalHistoryOther, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="其它病史" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding MedicalHistoryOther, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="500" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                                <TextBlock Text="寵物備註" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox AutomationProperties.AutomationId="txt-customer-pet-note"
                                                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,40">
                <Button Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="btn-customer-reset" Content="清除" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="btn-customer-submit" Content="送出資料" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Padding="28,12" FontSize="15" />
            </StackPanel>
    </StackPanel>
</UserControl>
