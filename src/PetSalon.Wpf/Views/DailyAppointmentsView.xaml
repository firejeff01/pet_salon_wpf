<UserControl x:Class="PetSalon.Wpf.Views.DailyAppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PetSalon.Wpf.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DailyAppointmentsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" Content="← 返回日曆" Command="{Binding BackCommand}" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="18" Foreground="{StaticResource Brown700Brush}"
                           Text="{Binding Date, StringFormat='{}{0:yyyy/MM/dd} 的預約'}" />
            </DockPanel>
        </Border>

        <!-- 動作列 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="取消原因：" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource Brown500Brush}" FontSize="13" />
                    <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="txt-cancel-reason"
                             Width="240" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SuccessButtonStyle}" Content="✓ 標記完成"
                            AutomationProperties.AutomationId="btn-mark-complete"
                            Command="{Binding MarkCompleteCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="✗ 取消預約"
                            AutomationProperties.AutomationId="btn-cancel-appointment"
                            Command="{Binding CancelAppointmentCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource DangerButtonStyle}" Content="🗑 刪除"
                            AutomationProperties.AutomationId="btn-delete-appointment"
                            Command="{Binding DeleteCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Appointments}" SelectedItem="{Binding Selected}"
                      AutomationProperties.AutomationId="grid-appointments">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="時間" Binding="{Binding Time, StringFormat='HH:mm'}" Width="80" />
                    <DataGridTextColumn Header="飼主" Binding="{Binding Owner.Name}" Width="*" />
                    <DataGridTextColumn Header="寵物" Binding="{Binding Pet.Name}" Width="*" />
                    <DataGridTextColumn Header="種類" Binding="{Binding Pet.Species}" Width="60" />
                    <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="取消原因" Binding="{Binding CancelReason}" Width="*" />
                    <DataGridTextColumn Header="備註" Binding="{Binding Note}" Width="2*" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
